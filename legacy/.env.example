# ============================================================================
# Copie para ".env" (mesma pasta) e preencha. NUNCA versione o .env (já está no .gitignore).
# Atalho: `python -m jiradash init` pergunta estes valores e grava o .env por você.
# ============================================================================

# --- Modo -------------------------------------------------------------------
JIRADASH_MODE=jira                 # jira = lê o seu Jira | demo = dados fictícios

# --- SERVIDOR DO JIRA (URL e login) -----------------------------------------
JIRA_FLAVOR=cloud                  # cloud (atlassian.net) | dc (Data Center / Server, hospedado por vocês)
JIRA_BASE_URL=https://suaempresa.atlassian.net   # DC: https://jira.suaempresa.com.br (sem / no final, sem /jira se não houver contexto)
JIRA_EMAIL=conta-de-servico@suaempresa.com       # LOGIN: só Cloud (e-mail da conta dona do token)
JIRA_TOKEN=                        # SENHA/TOKEN: Cloud = API token (https://id.atlassian.com/manage-profile/security/api-tokens)
                                   #              DC    = Personal Access Token (Perfil > Personal Access Tokens)

# --- Sincronização ------------------------------------------------------------
JIRADASH_SYNC_MIN=10               # de quantos em quantos minutos buscar mudanças
JIRADASH_TZ=America/Sao_Paulo      # fuso para "dia do vencimento", D-1/D-2 e horários

# --- Segurança do painel ------------------------------------------------------
JIRADASH_API_KEY=                  # vazio = painel aberto (só para uso local). Em rede, defina e envie em X-API-Key / ou use SSO no proxy
JIRADASH_ALLOW_WRITE=0             # 0 = só sugere (modo sombra). 1 = aprovação grava o responsável no Jira
JIRADASH_WEBHOOK_SECRET=           # opcional: assinatura do webhook /api/webhook/jira

# --- Banco ---------------------------------------------------------------------
POSTGRES_PASSWORD=                 # só para docker compose: defina uma senha forte para o PostgreSQL do contêiner
DATABASE_URL=                      # vazio = SQLite em app/data (ok para uma equipe). Produção: postgresql+psycopg://user:senha@host/jiradash
JIRADASH_CACHE_TTL=60              # segundos de cache das telas (0 desliga)
