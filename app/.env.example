# Modelo de variáveis do compose. Copie para `.env` (que é ignorado pelo git) e preencha.
# Não coloque segredos neste arquivo de exemplo.

# Senha do PostgreSQL: OBRIGATÓRIA e sem valor padrão. Gere uma, por exemplo: openssl rand -hex 16
POSTGRES_PASSWORD=

# Banco e usuário (opcionais; os padrões estão no docker-compose.yml)
# POSTGRES_DB=painel
# POSTGRES_USER=painel

# Jira real desligado por padrão. Só altere com autorização expressa.
# JIRA_LIVE_ENABLED=false

# Modo desenvolvimento: sem login e com todos os dados. Nunca exponha em rede com dados reais.
# DASHBOARD_DEV_MODE=true
