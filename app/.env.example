# Copie para .env (ou exporte as variáveis). Nunca versione o .env.
JIRADASH_MODE=jira            # demo | jira
JIRA_FLAVOR=cloud             # cloud | dc
JIRA_BASE_URL=https://suaempresa.atlassian.net      # DC: https://jira.suaempresa.com.br
JIRA_EMAIL=conta-de-servico@suaempresa.com          # só Cloud
JIRA_TOKEN=                   # Cloud: API token | DC: Personal Access Token (Bearer)
JIRADASH_SYNC_MIN=10          # intervalo da sincronização incremental
JIRADASH_ALLOW_WRITE=0        # 1 só depois de validar as sugestões em modo sombra
JIRADASH_API_KEY=             # defina em produção; o front envia em X-API-Key (ou ponha atrás de SSO)
JIRADASH_WEBHOOK_SECRET=      # opcional: valida X-Hub-Signature do webhook
DATABASE_URL=                 # vazio = SQLite local; produção: postgresql+psycopg://user:senha@host/jiradash
