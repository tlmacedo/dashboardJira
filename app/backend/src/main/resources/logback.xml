<configuration>
    <!--
        Registro enxuto: nível INFO, sem cabeçalhos nem corpos de requisição (podem conter tokens). Toda mensagem passa pela
        máscara de segredos (MascaraDeLog). Formato por PAINEL_LOG_FORMATO (JSON, padrão, ou TEXTO) e arquivo opcional por
        PAINEL_LOG_DIR. O Logback inicia antes do arquivo de variáveis ser lido: o ConfiguradorDeLog regrava as duas
        propriedades no contexto e relê este arquivo no começo do main.
    -->
    <!-- Sem o despejo de status do próprio Logback na saída (os apêndices não usados geram avisos de "não referenciado"). -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <conversionRule conversionWord="msgSeguro" class="br.sidia.painel.operacao.MensagemSeguraConverter"/>
    <conversionRule conversionWord="excSeguro" class="br.sidia.painel.operacao.ExcecaoSeguraConverter"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="br.sidia.painel.operacao.EncoderJsonSeguro"/>
    </appender>

    <appender name="TEXTO" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msgSeguro%n%excSeguro</pattern>
        </encoder>
    </appender>

    <!-- Só é referenciado quando há PAINEL_LOG_DIR; `lazy` evita criar o arquivo sem eventos. -->
    <appender name="ARQUIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <lazy>true</lazy>
        <file>${PAINEL_LOG_DIR:-${java.io.tmpdir}}/painel.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${PAINEL_LOG_DIR:-${java.io.tmpdir}}/painel.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="br.sidia.painel.operacao.EncoderJsonSeguro"/>
    </appender>

    <appender name="NADA" class="ch.qos.logback.core.helpers.NOPAppender"/>

    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.ktor" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="${PAINEL_LOG_FORMATO:-JSON}"/>
        <appender-ref ref="${PAINEL_LOG_ARQUIVO_REF:-NADA}"/>
    </root>
</configuration>
