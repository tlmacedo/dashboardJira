# Modelo do arquivo de variaveis de PRODUCAO do Painel de Squads (Plano 13).
# Copie para FORA do pacote e do repositorio, com o nome painel.env:
#   Windows: C:\Painel\dados\painel.env     Linux: /etc/painel/painel.env
# Preencha os marcadores (exemplo.invalid) com os valores da sua instalacao. O painel.env real NUNCA vai para o git nem para o
# pacote; a permissao e so da conta do servico (docs/implantacao/segredos.md). Os dois segredos abaixo ficam VAZIOS aqui:
# SESSION_SECRET e gerado pelo script gerar-session-secret; OIDC_CLIENT_SECRET e entregue pela infraestrutura.

# Producao: sem modo de desenvolvimento, sem dados de demonstracao.
DASHBOARD_DEV_MODE=false
DASHBOARD_DEMO_DATA=false

# ACESSO AO JIRA: este modelo NUNCA liga. So o usuario responsavel muda esta linha, depois do checklist da primeira conexao
# (docs/jira/checklist-primeira-conexao.md). Reinicie o painel depois de qualquer mudanca.
JIRA_LIVE_ENABLED=false

# Escuta: so a propria maquina; o proxy da empresa fica na frente e termina o TLS.
PAINEL_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_ORIGEM_PUBLICA=https://painel.exemplo.invalid
DASHBOARD_PROXY_CONFIAVEL=127.0.0.1/32,::1/128

# Login corporativo (OIDC). A claim vira o username do Jira pela estrategia escolhida.
OIDC_ISSUER=https://sso.exemplo.invalid/realms/exemplo
OIDC_CLIENT_ID=painel
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://painel.exemplo.invalid/auth/callback
OIDC_USERNAME_ESTRATEGIA=claim_direto
SESSION_SECRET=

# Caminhos ABSOLUTOS (a producao recusa caminho relativo). Windows:
DATABASE_PATH=C:\Painel\dados\data\painel.db
PAINEL_CONFIG_DIR=C:\Painel\dados\config
PAINEL_STATIC_DIR=C:\Painel\app\atual\frontend\dist
# Linux (troque as tres linhas acima por estas):
#   DATABASE_PATH=/var/lib/painel/painel.db
#   PAINEL_CONFIG_DIR=/etc/painel/config
#   PAINEL_STATIC_DIR=/opt/painel/atual/frontend/dist
